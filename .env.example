# Copier en .env et adapter. Ne jamais commiter .env.
POSTGRES_PASSWORD=remplacer-par-un-mot-de-passe-fort
SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
# production (par défaut) : SECRET_KEY de moins de 32 caractères ou d'exemple refusée,
# documentation /api/docs fermée. development pour un poste de développement.
ENVIRONMENT=production
# Sauvegarde chiffrée quotidienne (service backup). Sans la phrase de passe, les sauvegardes
# sont illisibles : la garder hors du serveur. Dossier à copier régulièrement ailleurs.
BACKUP_PASSPHRASE=remplacer-par-une-phrase-de-passe-longue
BACKUP_DIR=./backups
BACKUP_HOUR=2
BACKUP_KEEP_DAYS=14
# Stockage des fichiers : local (volume Docker, par défaut) ou s3 (profil « s3 », MinIO)
STORAGE_BACKEND=local
MINIO_ROOT_USER=meal
MINIO_ROOT_PASSWORD=remplacer-minio
MINIO_IMAGE=minio/minio:latest
# Domaine public servi par Caddy (localhost en local)
SITE_ADDRESS=localhost
# Clé API Anthropic (extraction IA) et plafond de dépense mensuel par organisation
ANTHROPIC_API_KEY=
AI_MONTHLY_BUDGET_USD=0
# Recherche sémantique (facultative) : clé Voyage AI pour les embeddings. Sans clé, la
# recherche reste en plein texte.
VOYAGE_API_KEY=
# SMS de la redevabilité (plaintes et retours). Par défaut "simulated" : aucun SMS ne part.
# Prestataires réels : "twilio" (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, SMS_SENDER) ou
# "africastalking" (AFRICASTALKING_USERNAME, AFRICASTALKING_API_KEY, SMS_SENDER facultatif).
SMS_PROVIDER=simulated
SMS_SENDER=
# Secret de l'URL de réception à déclarer chez le prestataire :
# https://<domaine>/api/v1/sms/inbound/<SMS_WEBHOOK_TOKEN>. Vide : réception désactivée.
SMS_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# WhatsApp (même logique) : "simulated" par défaut, "twilio" (TWILIO_ACCOUNT_SID,
# TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_SENDER) ou "meta" (WhatsApp Cloud API :
# META_WHATSAPP_TOKEN, META_WHATSAPP_PHONE_NUMBER_ID, META_APP_SECRET conseillé).
# Réception : https://<domaine>/api/v1/whatsapp/inbound/<SMS_WEBHOOK_TOKEN> ; chez Meta, le
# jeton de vérification est ce même SMS_WEBHOOK_TOKEN.
WHATSAPP_PROVIDER=simulated
TWILIO_WHATSAPP_SENDER=
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
